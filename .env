# whatsmeow-api local dev config
# Loaded automatically by the binary at startup (godotenv).
# You can also `source` this file in a shell; the format is compatible
# with both godotenv and bash.

# Required: any non-empty string. In dev, pick something memorable.
APP_MANAGER_PASSWORD=admin
APP_LOG=debug

# Optional overrides (defaults shown). APP_HTTP_ADDR accepts:
#   - a bare port ("8080" -> binds to :8080 on all interfaces)
#   - the canonical ":8080" form
#   - a specific host ("127.0.0.1:8080", "localhost:3000")
# APP_HTTP_ADDR=8080
# APP_MANAGER_USERNAME=admin
# APP_DB_DRIVER=sqlite3
# APP_DB_DSN=file:data/whatsmeow-api.db?_pragma=foreign_keys(1)
